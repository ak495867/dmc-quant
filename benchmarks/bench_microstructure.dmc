import "../src/dmc_quant";

#[bench]
fn bench_microstructure_vpin() -> int {
    var buys: [float; 4] = [500.0, 450.0, 600.0, 520.0];
    var sells: [float; 4] = [500.0, 550.0, 400.0, 480.0];
    var sum: float = 0.0;
    var i: int = 0;
    while (i < 10000) {
        let v: float = micro_vpin(&buys[0], &sells[0], 4, 1000.0);
        let obi: float = micro_order_book_imbalance(120, 80);
        sum = sum + v + obi;
        i = i + 1;
    }
    return 0;
}
