import "../src/dmc_quant";

#[bench]
fn bench_lob_matching() -> int {
    let b: int = lob_create(10);
    var i: int = 0;
    while (i < 1000) {
        lob_add_limit(b, i, 1, 10000 + (i % 20), 10);
        lob_add_limit(b, i + 10000, 2, 10010 + (i % 20), 10);
        i = i + 1;
    }
    return 0;
}
