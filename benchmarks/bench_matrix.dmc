import "../src/dmc_quant";

#[bench]
fn bench_cholesky_factorization() -> int {
    var l00: float = 0.0;
    var l10: float = 0.0;
    var l11: float = 0.0;
    var i: int = 0;
    while (i < 10000) {
        matrix_cholesky_2x2(4.0, 2.0, 5.0, &l00, &l10, &l11);
        i = i + 1;
    }
    return 0;
}
