import "../src/dmc_quant";

#[bench]
fn bench_timeseries_sma_rsi() -> int {
    var prices: [float; 20] = [
        100.0, 101.0, 102.0, 101.5, 103.0,
        102.5, 104.0, 105.0, 104.5, 106.0,
        107.0, 106.5, 108.0, 107.5, 109.0,
        110.0, 109.5, 111.0, 110.5, 112.0
    ];
    var i: int = 0;
    while (i < 5000) {
        let sma: float = ts_sma(&prices[0], 20, 10);
        let rsi: float = ts_rsi(&prices[0], 20, 10);
        i = i + 1;
    }
    return 0;
}
