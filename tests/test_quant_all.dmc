import "../src/dmc_quant";

#[test]
fn test_quant_end_to_end_pipeline() -> int {
    let book: int = lob_create(5);
    lob_add_limit(book, 901, 1, 15000, 100);
    lob_add_limit(book, 902, 2, 15100, 100);
    let mid_int: int = lob_mid_price(book);
    let mid_px: float = (mid_int as float) / 100.0;
    if (mid_px < 150.4 || mid_px > 150.6) {
        return 1;
    }

    let option_call: float = bs_call(mid_px, 150.0, 0.5, 0.04, 0.22);
    if (option_call < 8.0 || option_call > 12.0) {
        return 2;
    }

    let fix_msg: string = fix_build_new_order_single("TR999", "SPY", 1, option_call, 10, "QUANT_DESK", "EXCHANGE");
    if (text_find(fix_msg, "55=SPY") < 0) {
        return 3;
    }

    let rets: [float; 5] = [0.01, -0.005, 0.015, -0.01, 0.02];
    let vol: float = ts_volatility(&rets[0], 5);
    if (vol <= 0.0) {
        return 4;
    }

    let pvar: float = risk_parametric_var(100000.0, vol, 0.95);
    if (pvar <= 0.0) {
        return 5;
    }
    return 0;
}
