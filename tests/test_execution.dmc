import "../src/execution";

#[test]
fn test_twap_and_vwap_slicing() -> int {
    let s0: int = exec_twap_slice(100, 3, 0);
    let s1: int = exec_twap_slice(100, 3, 1);
    let s2: int = exec_twap_slice(100, 3, 2);
    if (s0 != 34 || s1 != 33 || s2 != 33) {
        return 1;
    }
    if ((s0 + s1 + s2) != 100) {
        return 2;
    }

    let vwap_s: int = exec_vwap_slice(1000, 20000, 100000);
    if (vwap_s != 200) {
        return 3;
    }
    return 0;
}

#[test]
fn test_pov_and_slippage() -> int {
    let pov_s: int = exec_pov_slice(1000, 0.10);
    if (pov_s != 111) {
        return 1;
    }

    let is_buy: float = exec_implementation_shortfall(100.0, 101.5, 1000, 1);
    if (is_buy < 1499.0 || is_buy > 1501.0) {
        return 2;
    }

    let is_sell: float = exec_implementation_shortfall(100.0, 99.0, 1000, 2);
    if (is_sell < 999.0 || is_sell > 1001.0) {
        return 3;
    }

    let bps_buy: float = exec_slippage_bps(100.0, 100.25, 1);
    if (bps_buy < 24.9 || bps_buy > 25.1) {
        return 4;
    }

    let bps_sell: float = exec_slippage_bps(100.0, 99.50, 2);
    if (bps_sell < 49.9 || bps_sell > 50.1) {
        return 5;
    }
    return 0;
}
