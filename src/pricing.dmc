c_code {
static double quant_cnd(double x) {
    return 0.5 * (1.0 + erf(x * 0.7071067811865475));
}

static double quant_pdf(double x) {
    const double inv_sqrt_2pi = 0.3989422804014327;
    return inv_sqrt_2pi * exp(-0.5 * x * x);
}
}

fn bs_call(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var price: float = 0.0;
    c_code {
        if (t <= 0.0 || sigma <= 0.0) {
            price = (s > k) ? (s - k) : 0.0;
        } else {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            double d2 = d1 - sigma * sqrt_t;
            price = (float)(s * quant_cnd(d1) - k * exp(-r * t) * quant_cnd(d2));
        }
    }
    return price;
}

fn bs_put(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var price: float = 0.0;
    c_code {
        if (t <= 0.0 || sigma <= 0.0) {
            price = (k > s) ? (k - s) : 0.0;
        } else {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            double d2 = d1 - sigma * sqrt_t;
            price = (float)(k * exp(-r * t) * quant_cnd(-d2) - s * quant_cnd(-d1));
        }
    }
    return price;
}

fn bs_delta_call(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var d: float = 0.0;
    c_code {
        if (t <= 0.0 || sigma <= 0.0) {
            d = (s >= k) ? 1.0 : 0.0;
        } else {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            d = (float)quant_cnd(d1);
        }
    }
    return d;
}

fn bs_delta_put(s: float, k: float, t: float, r: float, sigma: float) -> float {
    let dc: float = bs_delta_call(s, k, t, r, sigma);
    return dc - 1.0;
}

fn bs_gamma(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var g: float = 0.0;
    c_code {
        if (t > 0.0 && sigma > 0.0 && s > 0.0) {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            g = (float)(quant_pdf(d1) / (s * sigma * sqrt_t));
        }
    }
    return g;
}

fn bs_vega(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var v: float = 0.0;
    c_code {
        if (t > 0.0 && sigma > 0.0 && s > 0.0) {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            v = (float)(s * sqrt_t * quant_pdf(d1));
        }
    }
    return v;
}

fn bs_theta_call(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var th: float = 0.0;
    c_code {
        if (t > 0.0 && sigma > 0.0 && s > 0.0) {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            double d2 = d1 - sigma * sqrt_t;
            double term1 = -(s * quant_pdf(d1) * sigma) / (2.0 * sqrt_t);
            double term2 = -r * k * exp(-r * t) * quant_cnd(d2);
            th = (float)(term1 + term2);
        }
    }
    return th;
}

fn bs_rho_call(s: float, k: float, t: float, r: float, sigma: float) -> float {
    var rh: float = 0.0;
    c_code {
        if (t > 0.0 && sigma > 0.0 && s > 0.0) {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * sigma * sigma) * t) / (sigma * sqrt_t);
            double d2 = d1 - sigma * sqrt_t;
            rh = (float)(k * t * exp(-r * t) * quant_cnd(d2));
        }
    }
    return rh;
}

fn bs_implied_vol(s: float, k: float, t: float, r: float, market_price: float, is_call: int) -> float {
    var vol: float = 0.20;
    c_code {
        double v = 0.20;
        for (int iter = 0; iter < 64; iter = iter + 1) {
            double sqrt_t = sqrt(t);
            double d1 = (log(s / k) + (r + 0.5 * v * v) * t) / (v * sqrt_t);
            double d2 = d1 - v * sqrt_t;
            double model_px = is_call ? (s * quant_cnd(d1) - k * exp(-r * t) * quant_cnd(d2)) : (k * exp(-r * t) * quant_cnd(-d2) - s * quant_cnd(-d1));
            double diff = model_px - market_price;
            if (fabs(diff) < 1e-5) break;
            double vega = s * sqrt_t * quant_pdf(d1);
            if (vega < 1e-8) break;
            v = v - diff / vega;
            if (v <= 0.001) v = 0.001;
            if (v > 5.0) v = 5.0;
        }
        vol = (float)v;
    }
    return vol;
}

fn bs_monte_carlo(s: float, k: float, t: float, r: float, sigma: float, n_sims: int, is_call: int) -> float {
    var mean_payoff: float = 0.0;
    c_code {
        unsigned int seed = 123456789;
        double sum = 0.0;
        double drift = (r - 0.5 * sigma * sigma) * t;
        double vol_sqrt = sigma * sqrt(t);
        for (int i = 0; i < n_sims; i = i + 1) {
            seed = (seed * 1103515245 + 12345) & 0x7fffffff;
            double u1 = (double)seed / 2147483648.0;
            seed = (seed * 1103515245 + 12345) & 0x7fffffff;
            double u2 = (double)seed / 2147483648.0;
            if (u1 <= 1e-7) u1 = 1e-7;
            double z = sqrt(-2.0 * log(u1)) * cos(6.283185307179586 * u2);
            double st = s * exp(drift + vol_sqrt * z);
            double payoff = is_call ? ((st > k) ? (st - k) : 0.0) : ((k > st) ? (k - st) : 0.0);
            sum = sum + payoff;
        }
        mean_payoff = (float)(exp(-r * t) * (sum / n_sims));
    }
    return mean_payoff;
}

fn bs_simd_call_payoff8(s0: float, s1: float, s2: float, s3: float, s4: float, s5: float, s6: float, s7: float, strike: float) -> f32x8 {
    var p0: float = 0.0;
    var p1: float = 0.0;
    var p2: float = 0.0;
    var p3: float = 0.0;
    var p4: float = 0.0;
    var p5: float = 0.0;
    var p6: float = 0.0;
    var p7: float = 0.0;
    if (s0 > strike) { p0 = s0 - strike; }
    if (s1 > strike) { p1 = s1 - strike; }
    if (s2 > strike) { p2 = s2 - strike; }
    if (s3 > strike) { p3 = s3 - strike; }
    if (s4 > strike) { p4 = s4 - strike; }
    if (s5 > strike) { p5 = s5 - strike; }
    if (s6 > strike) { p6 = s6 - strike; }
    if (s7 > strike) { p7 = s7 - strike; }
    return f32x8(p0, p1, p2, p3, p4, p5, p6, p7);
}
