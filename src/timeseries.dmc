c_code {
static double ts_calc_mean(const double* vals, int n) {
    if (n <= 0) return 0.0;
    double sum = 0.0;
    for (int i = 0; i < n; i = i + 1) sum = sum + vals[i];
    return sum / n;
}

static double ts_calc_variance(const double* vals, int n, double mean) {
    if (n <= 1) return 0.0;
    double sum_sq = 0.0;
    for (int i = 0; i < n; i = i + 1) {
        double diff = vals[i] - mean;
        sum_sq = sum_sq + diff * diff;
    }
    return sum_sq / (n - 1);
}
}

fn ts_sma(prices: *float, count: int, period: int) -> float {
    var res: float = 0.0;
    c_code {
        if (prices && count >= period && period > 0) {
            double sum = 0.0;
            int start = count - period;
            for (int i = start; i < count; i = i + 1) {
                sum = sum + prices[i];
            }
            res = (float)(sum / period);
        }
    }
    return res;
}

fn ts_ema(prices: *float, count: int, period: int) -> float {
    var res: float = 0.0;
    c_code {
        if (prices && count > 0 && period > 0) {
            double alpha = 2.0 / (period + 1.0);
            double ema = prices[0];
            for (int i = 1; i < count; i = i + 1) {
                ema = prices[i] * alpha + ema * (1.0 - alpha);
            }
            res = (float)ema;
        }
    }
    return res;
}

fn ts_rsi(prices: *float, count: int, period: int) -> float {
    var res: float = 50.0;
    c_code {
        if (prices && count > period && period > 0) {
            double gains = 0.0;
            double losses = 0.0;
            for (int i = 1; i <= period; i = i + 1) {
                double diff = prices[i] - prices[i - 1];
                if (diff > 0.0) gains = gains + diff;
                else losses = losses - diff;
            }
            double avg_gain = gains / period;
            double avg_loss = losses / period;
            for (int i = period + 1; i < count; i = i + 1) {
                double diff = prices[i] - prices[i - 1];
                double g = (diff > 0.0) ? diff : 0.0;
                double l = (diff < 0.0) ? -diff : 0.0;
                avg_gain = (avg_gain * (period - 1) + g) / period;
                avg_loss = (avg_loss * (period - 1) + l) / period;
            }
            if (avg_loss <= 1e-9) {
                res = 100.0;
            } else {
                double rs = avg_gain / avg_loss;
                res = (float)(100.0 - (100.0 / (1.0 + rs)));
            }
        }
    }
    return res;
}

fn ts_macd_line(prices: *float, count: int, fast_p: int, slow_p: int) -> float {
    let fast_ema: float = ts_ema(prices, count, fast_p);
    let slow_ema: float = ts_ema(prices, count, slow_p);
    return fast_ema - slow_ema;
}

fn ts_bollinger_bands(prices: *float, count: int, period: int, k: float, out_upper: *float, out_mid: *float, out_lower: *float) -> int {
    var ok: int = 0;
    c_code {
        if (prices && count >= period && period > 1) {
            int start = count - period;
            double sum = 0.0;
            for (int i = start; i < count; i = i + 1) sum = sum + prices[i];
            double mid = sum / period;
            double sum_sq = 0.0;
            for (int i = start; i < count; i = i + 1) {
                double d = prices[i] - mid;
                sum_sq = sum_sq + d * d;
            }
            double std_dev = sqrt(sum_sq / (period - 1));
            if (out_mid) *out_mid = (float)mid;
            if (out_upper) *out_upper = (float)(mid + k * std_dev);
            if (out_lower) *out_lower = (float)(mid - k * std_dev);
            ok = 1;
        }
    }
    return ok;
}

fn ts_volatility(returns: *float, count: int) -> float {
    var vol: float = 0.0;
    c_code {
        if (returns && count > 1) {
            double sum = 0.0;
            for (int i = 0; i < count; i = i + 1) sum = sum + returns[i];
            double mean = sum / count;
            double sum_sq = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                double d = returns[i] - mean;
                sum_sq = sum_sq + d * d;
            }
            vol = (float)sqrt(sum_sq / (count - 1));
        }
    }
    return vol;
}

fn ts_skewness(returns: *float, count: int) -> float {
    var skew: float = 0.0;
    c_code {
        if (returns && count > 2) {
            double sum = 0.0;
            for (int i = 0; i < count; i = i + 1) sum = sum + returns[i];
            double mean = sum / count;
            double sum_sq = 0.0;
            double sum_cube = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                double d = returns[i] - mean;
                sum_sq = sum_sq + d * d;
                sum_cube = sum_cube + d * d * d;
            }
            double s2 = sum_sq / count;
            double s = sqrt(s2);
            if (s > 1e-9) {
                skew = (float)((sum_cube / count) / (s * s * s));
            }
        }
    }
    return skew;
}

fn ts_kurtosis(returns: *float, count: int) -> float {
    var kurt: float = 3.0;
    c_code {
        if (returns && count > 3) {
            double sum = 0.0;
            for (int i = 0; i < count; i = i + 1) sum = sum + returns[i];
            double mean = sum / count;
            double sum_sq = 0.0;
            double sum_quad = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                double d = returns[i] - mean;
                sum_sq = sum_sq + d * d;
                sum_quad = sum_quad + d * d * d * d;
            }
            double s2 = sum_sq / count;
            if (s2 > 1e-9) {
                kurt = (float)((sum_quad / count) / (s2 * s2));
            }
        }
    }
    return kurt;
}

fn ts_covariance(x: *float, y: *float, count: int) -> float {
    var cov: float = 0.0;
    c_code {
        if (x && y && count > 1) {
            double sx = 0.0, sy = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                sx = sx + x[i];
                sy = sy + y[i];
            }
            double mx = sx / count;
            double my = sy / count;
            double psum = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                psum = psum + (x[i] - mx) * (y[i] - my);
            }
            cov = (float)(psum / (count - 1));
        }
    }
    return cov;
}

fn ts_correlation(x: *float, y: *float, count: int) -> float {
    var corr: float = 0.0;
    c_code {
        if (x && y && count > 1) {
            double sx = 0.0, sy = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                sx = sx + x[i];
                sy = sy + y[i];
            }
            double mx = sx / count;
            double my = sy / count;
            double psum = 0.0, varx = 0.0, vary = 0.0;
            for (int i = 0; i < count; i = i + 1) {
                double dx = x[i] - mx;
                double dy = y[i] - my;
                psum = psum + dx * dy;
                varx = varx + dx * dx;
                vary = vary + dy * dy;
            }
            double denom = sqrt(varx * vary);
            if (denom > 1e-9) {
                corr = (float)(psum / denom);
            }
        }
    }
    return corr;
}
